# Application
PORT=3000
# If set, POST /api/v1/crawl requires header X-API-Key
API_KEY=

# Database (postgres | sqlite)
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=howwebiz
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
# sqlite only
DB_PATH=howwebiz.db
# silent | error | warn | info
DB_LOG=warn

# Crawler
CRAWL_BASE_URL=https://www.howwe.ug
CRAWL_USER_AGENT=howwebiz-api-crawler/1.0
# Minimum gap between requests to howwe.ug (shared by all workers)
CRAWL_REQUEST_DELAY=500ms
CRAWL_REQUEST_TIMEOUT=20s
# Default targets: hot100, audio-new, audio-day, audio-week, audio-month, audio-year, audio-alltime
CRAWL_TARGETS=hot100,audio-new
# Listing pages per paginated target (36 songs per page)
CRAWL_PAGES=3
CRAWL_DETAIL_WORKERS=4
# Base revisit interval for song pages; doubles (up to 8x) while a page stays unchanged
CRAWL_DETAIL_TTL=24h
# Cap on song pages per run (0 = no cap); the rest are fetched on the next run
CRAWL_DETAIL_MAX_PER_RUN=500

# Daily crawl
CRON_ENABLED=true
CRON_AT=03:00
CRON_TZ=Africa/Kampala

# Full catalog crawl (POST /api/v1/crawl/catalog; also runs after the daily crawl)
# Per-run budgets, 0 = unlimited. Leftover work resumes on the next run.
CATALOG_DAILY=true
CATALOG_MAX_PAGES=0
CATALOG_MAX_PROBES=5000
CATALOG_MAX_DETAILS=10000
# How often a synced catalog re-walks every genre (keeps genre membership fresh)
CATALOG_GENRE_REFRESH=168h

# Search. howwe.ug's own search is a Google Programmable Search Engine;
# querying it needs a Custom Search JSON API key (closed to new customers,
# discontinued 2027-01-01). Without a key, /search uses the local catalog.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=76ecd7f17cc7e4f1b
SEARCH_CACHE_TTL=6h

# audio.com (official public API; the website is behind a Cloudflare bot challenge)
# Connect once: GET /api/v1/audiocom/connect → open authorizeUrl → sign in.
AUDIOCOM_API_BASE=https://api.audio.com
# Must be reachable by your browser; registered with audio.com automatically
AUDIOCOM_REDIRECT_URL=http://localhost:3000/api/v1/audiocom/callback
# API limit is 60/min per user; stay a little under
AUDIOCOM_RATE_PER_MIN=55
# Tags walked as "#tag" feeds (genre-like), e.g. pop,hiphop,afrobeats
AUDIOCOM_TAGS=
AUDIOCOM_TAG_REFRESH=168h
AUDIOCOM_SEARCH_CACHE_TTL=10m
AUDIOCOM_DAILY=true
# Page budget for the daily audio.com crawl (0 = unlimited; 10 tracks/page)
AUDIOCOM_DAILY_MAX_PAGES=0

# audio.com WEBSITE crawl (HTML pages) — plain requests behind a block counter.
# It never tries to get past a block: it backs off, then pauses itself.
AUDIOCOM_WEB_BASE_URL=https://audio.com
AUDIOCOM_WEB_DELAY=3s
# Circuit breaker: open after N blocks in a row, or M blocks in one run
AUDIOCOM_WEB_MAX_CONSECUTIVE_BLOCKS=3
AUDIOCOM_WEB_MAX_BLOCKS_PER_RUN=5
# Backoff after a block (doubles per consecutive block)
AUDIOCOM_WEB_BLOCK_BACKOFF=30s
# Pause when the circuit opens (doubles each time it re-opens, capped)
AUDIOCOM_WEB_BLOCK_COOLDOWN=24h
AUDIOCOM_WEB_MAX_COOLDOWN=168h
# Stop after N pages in a row that load but contain no track data
AUDIOCOM_WEB_MAX_UNRECOGNIZED=3
AUDIOCOM_WEB_DAILY=true
AUDIOCOM_WEB_DAILY_MAX_PAGES=500
AUDIOCOM_WEB_GENRE_REFRESH=168h

# momuziki.com (HTML pages; robots.txt: Allow /, Content-Signal search=yes, ai-train=no)
MOMUZIKI_BASE_URL=https://www.momuziki.com
MOMUZIKI_DELAY=1s
MOMUZIKI_MAX_CONSECUTIVE_BLOCKS=3
MOMUZIKI_MAX_BLOCKS_PER_RUN=5
MOMUZIKI_BLOCK_BACKOFF=30s
MOMUZIKI_BLOCK_COOLDOWN=24h
MOMUZIKI_MAX_COOLDOWN=168h
# Per-run budgets (0 = unlimited); leftovers resume next run
MOMUZIKI_MAX_PAGES=0
MOMUZIKI_MAX_PROBES=2000
MOMUZIKI_MAX_DETAILS=2000
MOMUZIKI_DETAIL_TTL=24h
# Stop probing above the highest id after N misses in a row
MOMUZIKI_PROBE_AHEAD=25
MOMUZIKI_CATEGORY_REFRESH=168h
MOMUZIKI_DAILY=true

# Aggregated catalog (/api/v1/songs)
# Display/audio come from the first provider in this list that has them
CATALOG_PROVIDER_PRIORITY=howwe,ugamusic,pearltunes,mdundo,momuziki,mzikii,ugmuziki,busoga,audiocom,audius,jamendo,fma,internetarchive
# How often provider stores (howwe, momuziki, audio.com) are indexed into the catalog
CATALOG_INDEX_INTERVAL=2m
# Live provider search on /songs?q=… : per-provider timeout and per provider+query cache
CATALOG_LIVE_TIMEOUT=8s
CATALOG_LIVE_CACHE_TTL=15m
# Cached /songs pages and their totals (Redis); reindex/cleanup drop both
CATALOG_RESULT_CACHE_TTL=60s
CATALOG_COUNT_CACHE_TTL=5m

# Redis cache. Dev: `docker compose up -d redis`. Prod: runs inside the API
# container and the image pins these (docker-entrypoint.sh), so the values
# below only matter outside Docker. The API serves uncached if Redis is down.
REDIS_ENABLED=true
REDIS_ADDR=127.0.0.1:6379

# HTTP server timeouts
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=120s

# Generic HTML-site providers (modules/providers): <NAME>_* settings
# pearltunes.com — listing + song pages by id + search; robots.txt allows all
PEARLTUNES_BASE_URL=https://pearltunes.com
PEARLTUNES_DELAY=1s
PEARLTUNES_MAX_PAGES=0
PEARLTUNES_MAX_PROBES=3000
PEARLTUNES_PROBE_AHEAD=25
PEARLTUNES_REFRESH=168h
PEARLTUNES_DAILY=true
# ugamusic.net — sitemap + song pages only (its robots.txt disallows pagination and search; Crawl-delay 1 is honored)
UGAMUSIC_BASE_URL=https://ugamusic.net
UGAMUSIC_DELAY=1s
# song pages per run (each page also yields ~20 related songs)
UGAMUSIC_MAX_PROBES=3000
UGAMUSIC_DAILY=true
# Song pages fetched per live search for results listed without audio
PEARLTUNES_SEARCH_ENRICH=5

# Full-track APIs, worldwide (generic crawler, Feeder capability): <NAME>_* settings as above
# audius.co — public API, no key; newest-first feeds per genre
AUDIUS_BASE_URL=https://api.audius.co
AUDIUS_APP_NAME=howwebiz
AUDIUS_DELAY=1s
# comma-separated Audius genre names, "all" = every genre (default: all + ~50 genres)
# AUDIUS_GENRES=all,Afrobeats,Hip-Hop/Rap,Reggae
# only verified artists (far fewer tracks, fewer re-uploads of others' music)
AUDIUS_VERIFIED_ONLY=false
AUDIUS_MAX_PAGES=0
AUDIUS_DAILY=true
# jamendo.com — free client id from https://devportal.jamendo.com (provider is disabled while empty).
# API terms: free for non-commercial use only; commercial use needs a Jamendo licence.
JAMENDO_CLIENT_ID=
JAMENDO_DELAY=1s
JAMENDO_MAX_PAGES=0
JAMENDO_DAILY=true
# archive.org — netlabels + Live Music Archive; each feed page = 1 search + 1 metadata request per item
INTERNETARCHIVE_COLLECTIONS=netlabels,etree
INTERNETARCHIVE_ITEMS_PER_PAGE=25
INTERNETARCHIVE_MAX_PAGES=200
INTERNETARCHIVE_DELAY=1s
INTERNETARCHIVE_DAILY=true
